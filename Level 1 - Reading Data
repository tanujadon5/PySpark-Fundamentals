Level 1 — Reading Data Solutions

# You have two CSV files. How will you read them? 
df = spark.read.csv("/Volumes/workspace/default/volume_data/*.csv", header = True, inferSchema = True)
# -- use wildcard path by using * to read multiple csv files with same schema

# For 2 DFs
df1 = spark.read.csv("/Volumes/workspace/default/volume_data/*.csv", header = True, inferSchema = True)
df2 = spark.read.csv("/Volumes/workspace/default/volume_data/*.csv", header = True, inferSchema = True)
df1.union(df2)

# How will you read a CSV with headers? 
df = spark.read.csv("/Volumes/workspace/default/volume_data/*.csv", header = True, inferSchema = True)

# How will you read a CSV without headers? 
df = spark.read.csv("/Volumes/workspace/default/volume_data/*.csv", header = False, inferSchema = True)

# Spark will generate column names such as: 
# _c0 
# _c1 
# _c2 

# If you know the column names, you can rename them later. 
df = df.toDF("emp_id", "name", "salary") 

# How will you specify the schema while reading a CSV? 
schema = StructType([
    StructField("emp_id",IntegerType(),True),
    StructField("name",StringType(),True),
    StructField("salary",DoubleType(),True)
])

df = spark.read.csv("/Volumes/workspace/default/volume_data/*.csv", header = False, schema = schema) 

